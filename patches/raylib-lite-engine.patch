diff --git a/host/preview_audio.js b/host/preview_audio.js
new file mode 100644
index 0000000..b7095f4
--- /dev/null
+++ b/host/preview_audio.js
@@ -0,0 +1,89 @@
+// Generic preview audio: the C module supplies sequenced audio_events; only
+// manifest-declared WAV files are decoded. No gameplay is implemented here.
+const previewAudio = (() => {
+  const button = document.querySelector('#audio');
+  let context, master, preparation, enabled = false, userMuted = false;
+  let sourceMuted = false;
+  let lastSequence = 0, generation = 0, played = 0;
+  const buffers = new Map();
+  const pending = [];
+  const active = new Set();
+  function stopPlaying() {
+    pending.length = 0;
+    for (const source of active) {try {source.stop();} catch (_) {}}
+    active.clear();
+  }
+  function update() {
+    button.textContent = sourceMuted ? '游戏已静音' : enabled ? '音效：开' : '开启音效';
+    button.title = sourceMuted ? '在游戏内关闭静音即可恢复音效' : `已播放 ${played} 次`;
+    button.dataset.played = String(played);
+    button.dataset.ready = String(Boolean(context && context.state === 'running'));
+  }
+  function flush() {
+    while (pending.length) {
+      const event = pending.shift(), buffer = buffers.get(event.clip);
+      if (!enabled || sourceMuted || !buffer || Date.now() - event.received > 1200) continue;
+      const source = context.createBufferSource(), gain = context.createGain();
+      source.buffer = buffer;
+      gain.gain.value = Math.max(0, Math.min(1, Number(event.volume) || 0));
+      source.connect(gain); gain.connect(master);
+      active.add(source); source.onended = () => active.delete(source);
+      source.start(); played++;
+    }
+    update();
+  }
+  async function prepare() {
+    const infoResponse = await fetch('/api/v1/info');
+    if (!infoResponse.ok) throw Error('audio manifest unavailable');
+    const info = await infoResponse.json();
+    await Promise.all(Object.entries(info.audio_clips || {}).map(async ([name, url]) => {
+      const response = await fetch(url);
+      if (!response.ok) throw Error('audio clip unavailable');
+      buffers.set(name, await context.decodeAudioData(await response.arrayBuffer()));
+    }));
+  }
+  function unlock(force = false) {
+    if (userMuted && !force) return;
+    try {
+      if (!context) {
+        const Audio = window.AudioContext || window.webkitAudioContext;
+        if (!Audio) throw Error('Web Audio unavailable');
+        context = new Audio(); master = context.createGain(); master.connect(context.destination);
+      }
+      // resume must run directly within the pointer/key gesture, before fetch.
+      const resumed = context.resume();
+      userMuted = false; enabled = true; master.gain.value = sourceMuted ? 0 : 0.85; update();
+      if (!preparation) preparation = prepare();
+      Promise.all([resumed, preparation]).then(flush).catch(() => {
+        enabled = false; preparation = null; update(); button.textContent = '重试音效';
+      });
+    } catch (_) {
+      enabled = false; update(); button.textContent = '音效不可用';
+    }
+  }
+  function consume(events, currentGeneration, muted = false) {
+    if (sourceMuted !== Boolean(muted)) {
+      sourceMuted = Boolean(muted);
+      if (sourceMuted) stopPlaying();
+      if (master) master.gain.value = enabled && !sourceMuted ? 0.85 : 0;
+      update();
+    }
+    if (currentGeneration !== generation) {
+      generation = currentGeneration; lastSequence = 0; stopPlaying();
+    }
+    for (const event of events) {
+      if (!Number.isSafeInteger(event.seq) || event.seq <= lastSequence) continue;
+      lastSequence = event.seq;
+      if (enabled && !sourceMuted) pending.push({...event, received: Date.now()});
+    }
+    if (pending.length > 16) pending.splice(0, pending.length - 16);
+    if (enabled && preparation) preparation.then(flush).catch(() => {});
+  }
+  button.onclick = () => {
+    if (sourceMuted) return;
+    if (enabled) {userMuted = true; enabled = false; master.gain.value = 0; stopPlaying(); update();}
+    else unlock(true);
+  };
+  update();
+  return {unlock, consume};
+})();
