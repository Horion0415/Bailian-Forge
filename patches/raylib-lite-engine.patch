+from pathlib import Path
+import importlib.util
+import json
+import shutil
+import subprocess
+import tempfile
+import unittest
+
+ROOT = Path(__file__).resolve().parents[1]
+SPEC = importlib.util.spec_from_file_location('preview_media_runtime', ROOT/'host/run_game.py')
+HOST = importlib.util.module_from_spec(SPEC)
+SPEC.loader.exec_module(HOST)
+
+class PreviewMediaTests(unittest.TestCase):
+    def test_declared_local_clip_and_smooth_image(self):
+        with tempfile.TemporaryDirectory() as directory:
+            root=Path(directory);(root/'hit.wav').write_bytes(b'RIFF')
+            (root/'game.sim.json').write_text(json.dumps({'audio':{'clips':{'hit':'hit.wav'}},'display':{'image_rendering':'auto'}}))
+            clips,rendering=HOST.preview_media(root)
+            self.assertEqual(clips,{'hit':root/'hit.wav'})
+            self.assertEqual(rendering,'auto')
+
+    def test_media_cannot_escape_project(self):
+        with tempfile.TemporaryDirectory() as directory:
+            root=Path(directory)
+            (root/'game.sim.json').write_text(json.dumps({'audio':{'clips':{'hit':'../outside.wav'}}}))
+            with self.assertRaisesRegex(ValueError,'leaves project'):HOST.preview_media(root)
+
+    @unittest.skipUnless(shutil.which('node'),'Node required for Web Audio event tests')
+    def test_audio_gesture_dedup_mute_and_reload(self):
+        subprocess.run(['node',str(ROOT/'tests/test_preview_audio.cjs'),str(ROOT/'host/preview_audio.js')],check=True)
